# Supabase Postgres connection string. Find it in your Supabase project:
# Settings -> Database -> Connection string -> "Transaction pooler" (URI tab).
# Use the pooler connection (port 6543) for serverless/Next.js, not the
# direct connection (port 5432).
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# LangChain agents (Agent 1: Template Generator, Agent 2: JSON Updater) use
# API keys configured in the Admin Portal (/admin/settings), stored in the
# database — not read from .env. The keys below are optional local fallbacks
# only if you wire up your own env-based provider selection.

# OpenAI
# OPENAI_API_KEY=sk-...

# Google Gemini — get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=AIza...