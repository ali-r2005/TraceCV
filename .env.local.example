# LangChain agents (Agent 1: Template Generator, Agent 2: JSON Updater) need
# at least one AI provider key below.

# OpenAI (used when AI_PROVIDER=openai, the default)
OPENAI_API_KEY=sk-...

# Google Gemini — get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Optional: choose which provider the agents use ("openai" or "gemini").
# Defaults to "openai" if unset.
# AI_PROVIDER=gemini

# Optional: override the SQLite database file location
# SQLITE_DB_PATH=./data/tracecv.sqlite